###############################################################################
# Committed defaults for `task`, loaded by every task via the root Taskfile.
# Override in the uncommitted sibling `.env.local`.
###############################################################################

# Cap the worker count for the check/test/lint tasks so they don't swamp a busy
# machine. Leave empty for tool defaults.
STIRLING_CHECK_JOBS=

###############################################################################
# Frontend environment variables for core and proprietary builds.
# Values can be overridden in the uncommitted sibling `.env.local` file.
# Note: This file is committed to Git, so should not contain any private keys.
###############################################################################

# API base URL — use / for same-origin (default for web builds)
VITE_API_BASE_URL=/

# Include the processor's lazy route/chunk. Off for client-side web builds.
VITE_INCLUDE_PORTAL=false

# Google Drive integration
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_APP_ID=

# Supabase configuration (blank for 100% local operation)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Stripe checkout (blank for 100% local operation)
VITE_STRIPE_PUBLISHABLE_KEY=

# PostHog analytics (blank for zero telemetry)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# Calendly scheduling link
VITE_CALENDLY_URL=

