{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@app/*": ["./src/*"],
      "@core/*": ["./src/*"],
      "@proprietary/*": ["./src/*"],
      "@portal/*": ["./src/portal/*"],
      "@desktop/*": ["./src/desktop/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "src/global.d.ts",
    "vite-env.d.ts",
    "vite.config.ts",
    "scripts/icons/svgrOptions.mts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/desktop"
  ]
}
