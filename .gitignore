# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
dist-ssr/
build/
*.tsbuildinfo

# Tauri desktop build outputs
src-tauri/target/

# Environment files & secrets (only committed default .env is tracked)
.env*
!/.env

# Test & coverage artifacts
coverage/
playwright-report/
test-results/
.nyc_output/
.playwright-mcp/
*.playwright-mcp.png
screenshots/

# Temporary / scratch directory
scratch/
tmp/
*.tmp
*.bak
*.orig

# Archives
*.zip
*.tar.gz

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor files
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.claude/*
!.claude/settings.json
!.claude/skills/

# Security & Certificates (Prevent secret leakage)
*.p12
*.pk8
*.pem
*.crt
*.cer
*.cert
*.der
*.key
*.csr
*.kdbx
*.jks
*.asc
id_rsa
id_rsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub
.ssh/

# Task checksum cache
.task/
