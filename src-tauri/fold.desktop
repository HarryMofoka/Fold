[Desktop Entry]
Version=1.0
Type=Application
Name=Fold
Comment=Privacy-first local PDF workspace that allows you to perform various operations on PDF files
TryExec={{exec}}
Exec={{exec}} %F
Icon={{icon}}
Terminal=false
MimeType=application/pdf;
Categories=Office;Graphics;Utility;
Actions=open-file;
StartupWMClass=Fold

[Desktop Action open-file]
Name=Open PDF File
Exec={{exec}} %F
